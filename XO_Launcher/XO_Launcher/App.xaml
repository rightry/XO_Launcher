<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="XO_Launcher.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:XO_Launcher">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0E0E0E" />
                    <SolidColorBrush x:Key="BarBackgroundBrush" Color="#1B1B1B" />
                    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#2D2D2D" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#7CBD4B" />
                    <SolidColorBrush x:Key="AccentDarkBrush" Color="#5B8731" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F0F0F0" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9E9E9E" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#151515" />
                    <SolidColorBrush x:Key="CardAltBackgroundBrush" Color="#101010" />
                    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#141414" />
                    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0E0E0E" />
                    <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#1B1B1B" />
                    <SolidColorBrush x:Key="NeutralButtonBrush" Color="#2D2D2D" />
                    <SolidColorBrush x:Key="NeutralButtonForegroundBrush" Color="#DDDDDD" />
                    <SolidColorBrush x:Key="ChromeTextBrush" Color="#E6E6E6" />
                    <SolidColorBrush x:Key="AccentOnBrush" Color="#0F1F0A" />
                    <SolidColorBrush x:Key="DangerButtonBrush" Color="#3A2222" />
                    <SolidColorBrush x:Key="DangerButtonForegroundBrush" Color="#E8B4B4" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="BarBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#E8E8E8" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#5B8731" />
                    <SolidColorBrush x:Key="AccentDarkBrush" Color="#4A7028" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#666666" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#D4D4D4" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardAltBackgroundBrush" Color="#F7F7F7" />
                    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#ECECEC" />
                    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#E8E8E8" />
                    <SolidColorBrush x:Key="NeutralButtonBrush" Color="#E6E6E6" />
                    <SolidColorBrush x:Key="NeutralButtonForegroundBrush" Color="#222222" />
                    <SolidColorBrush x:Key="ChromeTextBrush" Color="#222222" />
                    <SolidColorBrush x:Key="AccentOnBrush" Color="#0F1F0A" />
                    <SolidColorBrush x:Key="DangerButtonBrush" Color="#F3D6D6" />
                    <SolidColorBrush x:Key="DangerButtonForegroundBrush" Color="#8A2B2B" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
