<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="XO_Launcher.Views.CrashAnalysisPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4" Margin="0,0,0,10">
            <TextBlock x:Name="KindText" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
            <TextBlock x:Name="HeadlineText" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <StackPanel x:Name="FindingsHost" Spacing="8" />
        </ScrollViewer>

        <StackPanel Grid.Row="2" Spacing="6" Margin="0,12,0,0">
            <TextBlock Text="日志摘录" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
            <TextBox x:Name="ExcerptBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     FontFamily="Consolas" FontSize="11" MinHeight="88" MaxHeight="140"
                     Background="{ThemeResource InputBackgroundBrush}" Foreground="{ThemeResource TextPrimaryBrush}" BorderBrush="{ThemeResource DividerBrush}" />
        </StackPanel>

        <StackPanel x:Name="ActionsBar" Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <Button Content="重新分析" Height="32" Padding="14,0" Background="{ThemeResource NeutralButtonBrush}" Foreground="{ThemeResource NeutralButtonForegroundBrush}"
                    BorderThickness="0" CornerRadius="4" FontSize="12" Click="Refresh_Click" />
            <Button Content="选择日志文件" Height="32" Padding="14,0" Background="{ThemeResource NeutralButtonBrush}" Foreground="{ThemeResource NeutralButtonForegroundBrush}"
                    BorderThickness="0" CornerRadius="4" FontSize="12" Click="PickFile_Click" />
            <Button Content="导出崩溃日志" Height="32" Padding="14,0"
                    Background="{ThemeResource AccentBrush}" Foreground="#0F1F0A"
                    BorderThickness="0" CornerRadius="4" FontSize="12" Click="Export_Click" />
            <TextBlock x:Name="StatusText" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}"
                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="280" />
        </StackPanel>
    </Grid>
</UserControl>
