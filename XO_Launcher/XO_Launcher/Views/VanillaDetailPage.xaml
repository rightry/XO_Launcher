<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="XO_Launcher.Views.VanillaDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="24,14,24,0">
            <Button x:Name="BackButton" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="返回版本列表" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <StackPanel MaxWidth="820" HorizontalAlignment="Stretch" Padding="24,12,24,32" Spacing="16">

                <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1" Padding="20">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="IconBorder" Width="72" Height="72" CornerRadius="12" Background="#5B8731">
                            <TextBlock Text="MC" FontSize="20" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText" FontSize="26" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border x:Name="TypeChip" Background="#1B2A1B" CornerRadius="4" Padding="8,3">
                                    <TextBlock x:Name="TypeText" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentBrush}" />
                                </Border>
                                <TextBlock x:Name="MetaText" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="DescriptionText" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1" Padding="20">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="模组加载器" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                            <TextBlock FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap"
                                       Text="选择加载器后会与游戏装进同一个文件夹。Fabric 可单独选择加载器版本，Fabric API 可选装。" />
                        </StackPanel>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="CardVanilla" Tag="vanilla" Click="LoaderCard_Click" Height="72" HorizontalAlignment="Stretch"
                                    Background="#1B2A1B" BorderBrush="{ThemeResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="0">
                                <StackPanel>
                                    <TextBlock Text="原版" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}" />
                                    <TextBlock Text="不装加载器" FontSize="10" HorizontalAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CardFabric" Grid.Column="1" Tag="fabric" Click="LoaderCard_Click" Height="72" HorizontalAlignment="Stretch"
                                    Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" Padding="0">
                                <StackPanel>
                                    <TextBlock Text="Fabric" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}" />
                                    <TextBlock Text="单独选择版本" FontSize="10" HorizontalAlignment="Center" Foreground="#DB7E35" Margin="0,4,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CardForge" Grid.Column="2" Tag="forge" Click="LoaderCard_Click" Height="72" HorizontalAlignment="Stretch"
                                    Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" Padding="0">
                                <StackPanel>
                                    <TextBlock Text="Forge" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}" />
                                    <TextBlock Text="经典生态" FontSize="10" HorizontalAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CardNeoForge" Grid.Column="3" Tag="neoforge" Click="LoaderCard_Click" Height="72" HorizontalAlignment="Stretch"
                                    Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" Padding="0">
                                <StackPanel>
                                    <TextBlock Text="NeoForge" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}" />
                                    <TextBlock Text="新版本分支" FontSize="10" HorizontalAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CardQuilt" Grid.Column="4" Tag="quilt" Click="LoaderCard_Click" Height="72" HorizontalAlignment="Stretch"
                                    Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" Padding="0">
                                <StackPanel>
                                    <TextBlock Text="Quilt" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}" />
                                    <TextBlock Text="Fabric 兼容" FontSize="10" HorizontalAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <StackPanel x:Name="LoaderVersionPanel" Spacing="10" Visibility="Collapsed">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="LoaderVersionLabel" Text="加载器版本" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                                <ComboBox x:Name="LoaderVersionBox" HorizontalAlignment="Stretch" PlaceholderText="选择加载器版本"
                                          SelectionChanged="LoaderVersionBox_SelectionChanged" />
                                <ToggleSwitch x:Name="ShowAllLoaderToggle" Header="显示全部加载器版本（含测试版）" OnContent="全部" OffContent="仅稳定 / 正式"
                                              FontSize="12" Visibility="Collapsed" Toggled="ShowAllLoaderToggle_Toggled" />
                            </StackPanel>
                            <Border x:Name="FabricApiPanel" Background="{ThemeResource CardAltBackgroundBrush}" CornerRadius="8" Padding="14,10" Visibility="Collapsed">
                                <StackPanel Spacing="4">
                                    <ToggleSwitch x:Name="FabricApiToggle" Header="同时安装 Fabric API" OnContent="安装" OffContent="不安装"
                                                  IsOn="True" FontSize="12" />
                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap"
                                               Text="关闭后只安装 Fabric 加载器。多数 Fabric 模组需要 Fabric API，可稍后在模组页单独下载。" />
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="LoaderStatusText" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1" Padding="20">
                    <StackPanel Spacing="8">
                        <TextBlock Text="游戏名称" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                        <TextBlock FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   Text="下载后显示在首页。文件夹、版本 JSON 和客户端 jar 都会使用这个名字。" />
                        <TextBox x:Name="GameNameBox" Background="{ThemeResource InputBackgroundBrush}" Foreground="{ThemeResource TextPrimaryBrush}" BorderBrush="{ThemeResource DividerBrush}" FontSize="13"
                                 PlaceholderText="例如：我的生存" TextChanged="GameNameBox_TextChanged" />
                        <TextBlock x:Name="FolderHintText" FontSize="11" Foreground="{ThemeResource AccentBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Button x:Name="InstallButton" Height="52" HorizontalAlignment="Stretch" Background="{ThemeResource AccentBrush}"
                        Foreground="{ThemeResource AccentOnBrush}" BorderThickness="0" FontSize="16" FontWeight="Bold" CornerRadius="8"
                        Click="InstallButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE896;" FontSize="16" Foreground="{ThemeResource AccentOnBrush}" />
                        <TextBlock x:Name="InstallButtonText" Text="下载并安装" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border x:Name="QueueTipBorder" Background="#1B2A1B" CornerRadius="8" Padding="12,8" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8FD;" FontSize="13" Foreground="{ThemeResource AccentBrush}" />
                        <TextBlock x:Name="QueueTip" FontSize="12" Foreground="{ThemeResource AccentBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
