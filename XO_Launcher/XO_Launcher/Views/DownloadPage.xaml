<UserControl
    x:Class="XO_Launcher.Views.DownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:XO_Launcher.Models"
    xmlns:views="using:XO_Launcher.Views"
    mc:Ignorable="d">

    <UserControl.Resources>
        <models:SlugToVisibilityConverter x:Key="SlugToVisibilityConverter" />
        <models:HexToBrushConverter x:Key="HexToBrushConverter" />
        <models:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <models:VersionTypeBrushConverter x:Key="VersionTypeBrushConverter" />

        <Style x:Key="FilterChipStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource ChipBackgroundBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="DownloadSideButtonStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style x:Key="SearchFieldStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="4,0,6,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="44" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="AcceptsReturn" Value="False" />
        </Style>

        <Style x:Key="SearchIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="218" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 下载分类侧边栏 -->
        <Border Grid.Column="0" Background="{ThemeResource SidebarBackgroundBrush}" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,1,0">
            <StackPanel Padding="18,24,14,18" Spacing="4">
                <TextBlock Text="下载资源" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" Margin="8,0,0,18" />

                <Button x:Name="VanillaButton" Tag="vanilla" Content="原版游戏" Style="{StaticResource DownloadSideButtonStyle}" />
                <Button x:Name="LoaderButton" Tag="loader" Content="模组加载器" Style="{StaticResource DownloadSideButtonStyle}" />

                <Rectangle Height="1" Fill="{ThemeResource DividerBrush}" Margin="8,14,8,14" />

                <Button x:Name="ModsButton" Tag="mod" Content="模组" Style="{StaticResource DownloadSideButtonStyle}" />
                <Button x:Name="ShadersButton" Tag="shader" Content="光影" Style="{StaticResource DownloadSideButtonStyle}" />
                <Button x:Name="ResourcePacksButton" Tag="resourcepack" Content="资源包" Style="{StaticResource DownloadSideButtonStyle}" />
                <Button x:Name="ModpacksButton" Tag="modpack" Content="整合包" Style="{StaticResource DownloadSideButtonStyle}" />

                <Border Background="{ThemeResource ChipBackgroundBrush}" CornerRadius="8" Padding="12" Margin="8,30,8,0">
                    <StackPanel Spacing="6">
                        <TextBlock Text="内容来源" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Border Width="18" Height="18" CornerRadius="4" Background="#5B8731">
                                <TextBlock Text="M" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Modrinth" Foreground="#C8C8C8" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="原版版本来自 Mojang" Foreground="#777777" FontSize="10" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- 资源列表 -->
        <Grid Grid.Column="1" Padding="28,24,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="原版游戏" FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock x:Name="PageSubtitle" Text="从 Mojang 官方清单获取 Minecraft Java 版本" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,5,0,0" />
                </StackPanel>
                <TextBlock x:Name="SourceStatus" Text="正在连接资源平台..." FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,22,0,18" Spacing="12">
                <Border x:Name="SearchBarBorder" Height="46" CornerRadius="10"
                        Background="{ThemeResource CardBackgroundBrush}"
                        BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE721;" FontSize="14" Margin="14,0,2,0"
                                  Foreground="{ThemeResource TextSecondaryBrush}"
                                  VerticalAlignment="Center" />
                        <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource SearchFieldStyle}"
                                 PlaceholderText="搜索版本、模组、光影或资源包…" />
                        <Button x:Name="ClearSearchButton" Grid.Column="2" Style="{StaticResource SearchIconButtonStyle}"
                                Visibility="Collapsed" Click="ClearSearchButton_Click" ToolTipService.ToolTip="清除">
                            <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </Button>
                        <Button x:Name="SearchButton" Grid.Column="3" Height="32" MinWidth="72" Padding="14,0" Margin="4,0,7,0"
                                Background="{ThemeResource AccentBrush}" Foreground="{ThemeResource AccentOnBrush}"
                                BorderThickness="0" CornerRadius="8" FontSize="12" FontWeight="SemiBold"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE721;" FontSize="12" />
                                <TextBlock Text="搜索" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
                <StackPanel x:Name="VanillaFilterPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                    <Button x:Name="FilterAllButton" Content="全部" Tag="all" Style="{StaticResource FilterChipStyle}" Click="VanillaFilter_Click" />
                    <Button x:Name="FilterReleaseButton" Content="正式版" Tag="release" Style="{StaticResource FilterChipStyle}" Click="VanillaFilter_Click" />
                    <Button x:Name="FilterSnapshotButton" Content="快照" Tag="snapshot" Style="{StaticResource FilterChipStyle}" Click="VanillaFilter_Click" />
                    <Button x:Name="FilterLegacyButton" Content="远古" Tag="legacy" Style="{StaticResource FilterChipStyle}" Click="VanillaFilter_Click" />
                    <TextBlock x:Name="VanillaCountText" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>

            <GridView Grid.Row="2" x:Name="ItemsGrid" SelectionMode="None" IsItemClickEnabled="True" ItemClick="ItemsGrid_ItemClick">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" HorizontalAlignment="Left" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Border Width="278" MinHeight="126" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,14,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="11">
                                    <Border Width="42" Height="42" CornerRadius="8" Background="{Binding IconColor, Converter={StaticResource HexToBrushConverter}}">
                                        <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" MaxWidth="190">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding OriginalTitle}" FontSize="10" Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding HasTranslatedTitle, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="{ThemeResource AccentBrush}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" MaxLines="2" Margin="0,10,0,8" TextTrimming="CharacterEllipsis" />
                                <Grid Grid.Row="2">
                                    <TextBlock Text="{Binding Meta}" FontSize="10" Foreground="#777777" />
                                    <TextBlock Text="点击查看详情 ›" FontSize="10" Foreground="{ThemeResource AccentBrush}"
                                               HorizontalAlignment="Right"
                                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>
                                <FontIcon Glyph="&#xE76C;" FontSize="11" Foreground="#555555" HorizontalAlignment="Right" VerticalAlignment="Top"
                                          Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <ListView Grid.Row="2" x:Name="VanillaList" SelectionMode="None" IsItemClickEnabled="True"
                      ItemClick="ItemsGrid_ItemClick" Visibility="Collapsed">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="4,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="6"
                                    Background="{Binding IconColor, Converter={StaticResource HexToBrushConverter}}">
                                <TextBlock Text="MC" FontSize="11" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{Binding Converter={StaticResource VersionTypeBrushConverter}, ConverterParameter=title}" />
                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Badge}" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"
                                       Foreground="{Binding VersionType, Converter={StaticResource VersionTypeBrushConverter}}" />
                            <TextBlock Grid.Column="3" Text="{Binding Meta}" FontSize="11" Foreground="#777777" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Grid.Row="2" x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <ProgressRing IsActive="True" Width="34" Height="34" Foreground="{ThemeResource AccentBrush}" />
                <TextBlock Text="正在加载资源..." Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12" />
            </StackPanel>
        </Grid>

        <!-- mod 详情页覆盖层 -->
        <Grid x:Name="DetailOverlay" Grid.ColumnSpan="2" Background="{ThemeResource AppBackgroundBrush}" Visibility="Collapsed">
            <views:ModDetailPage x:Name="DetailPage" />
            <views:VanillaDetailPage x:Name="VanillaDetail" Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
