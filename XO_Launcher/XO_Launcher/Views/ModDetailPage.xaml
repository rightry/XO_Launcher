<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="XO_Launcher.Views.ModDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:XO_Launcher.Models"
    mc:Ignorable="d">

    <UserControl.Resources>
        <models:VersionTypeBrushConverter x:Key="VersionTypeBrushConverter" />
        <models:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="FilterChipStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource ChipBackgroundBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 顶栏：返回按钮 ==================== -->
        <Grid Padding="24,14,24,0">
            <Button x:Name="BackButton" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="返回资源列表" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" x:Name="ContentScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" Visibility="Collapsed">
            <StackPanel MaxWidth="880" HorizontalAlignment="Stretch" Padding="24,16,24,32" Spacing="18">

                <!-- ==================== mod 头部 ==================== -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- mod 图标 -->
                    <Border x:Name="IconBorder" Width="72" Height="72" CornerRadius="10" Background="#2D2D2D" VerticalAlignment="Top">
                        <Grid>
                            <TextBlock x:Name="IconFallback" Text="?" FontSize="26" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="IconImage" Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <!-- 标题与元信息 -->
                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Top">
                        <TextBlock x:Name="TitleText" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
                        <TextBlock x:Name="BadgeText" FontSize="12" Foreground="{ThemeResource AccentBrush}" />
                        <TextBlock x:Name="StatsText" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />

                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                            <TextBlock Text="支持加载器" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <ItemsControl x:Name="LoaderItems">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{ThemeResource ChipBackgroundBrush}" CornerRadius="4" Padding="8,3" Margin="0,0,6,4">
                                            <TextBlock Text="{Binding}" FontSize="11" Foreground="#C8C8C8" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                            <TextBlock Text="游戏版本" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <ItemsControl x:Name="GameVersionItems">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#152B20" CornerRadius="4" Padding="8,3" Margin="0,0,6,4">
                                            <TextBlock Text="{Binding}" FontSize="11" Foreground="{ThemeResource AccentBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ==================== 介绍（默认折叠） ==================== -->
                <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="10"
                        BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1" Padding="8,4">
                    <Expander x:Name="IntroExpander" IsExpanded="False" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch">
                        <Expander.Header>
                            <TextBlock x:Name="IntroTitleText" Text="模组介绍" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                        </Expander.Header>
                        <StackPanel Spacing="8" Padding="4,8,4,4">
                            <TextBlock x:Name="DescriptionText" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            <RichTextBlock x:Name="BodyMarkdown" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                    </Expander>
                </Border>

                <!-- ==================== 版本选择（按 Minecraft 版本分栏，仅在此页下载） ==================== -->
                <StackPanel Spacing="10">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="VersionSectionTitle" Text="按游戏版本与加载器选择文件" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                        <TextBlock x:Name="VersionSectionHint" Text="文件将保存至资源下载目录。请在版本设置中选择并安装。进度请在「消息」中查看。" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ChannelReleaseButton" Content="正式版" Tag="release"
                                    Style="{StaticResource FilterChipStyle}" Click="ChannelButton_Click" />
                            <Button x:Name="ChannelSnapshotButton" Content="快照版" Tag="snapshot"
                                    Style="{StaticResource FilterChipStyle}" Click="ChannelButton_Click" />
                        </StackPanel>

                        <TextBlock x:Name="LibraryPathText" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <ItemsControl x:Name="VersionGroups">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="10" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1" Margin="0,0,0,10">
                                    <Expander IsExpanded="{Binding IsExpanded}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <Expander.Header>
                                            <StackPanel Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE823;" FontSize="13" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding MinecraftVersion}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding VersionCountText}" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding LoaderSummary}" FontSize="10" Foreground="{ThemeResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Expander.Header>

                                        <ItemsControl ItemsSource="{Binding Loaders}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{ThemeResource CardAltBackgroundBrush}" CornerRadius="8" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1" Margin="0,6,0,4">
                                                        <Expander IsExpanded="{Binding IsExpanded}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                                            <Expander.Header>
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <Border Background="#1B2A1B" CornerRadius="4" Padding="8,2">
                                                                        <TextBlock Text="{Binding LoaderName}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentBrush}" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding VersionCountText}" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Expander.Header>

                                                            <ItemsControl ItemsSource="{Binding Versions}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0" Padding="14,10">
                                                                            <Grid ColumnSpacing="12">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                </Grid.ColumnDefinitions>

                                                                                <StackPanel Spacing="4">
                                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                        <TextBlock Text="{Binding VersionNumber}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                                                                   Foreground="{Binding Converter={StaticResource VersionTypeBrushConverter}, ConverterParameter=title}" />
                                                                                        <Border Background="#3A1518" CornerRadius="3" Padding="6,1" VerticalAlignment="Center"
                                                                                                Visibility="{Binding IsAlpha, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                            <TextBlock Text="Alpha" FontSize="10" FontWeight="SemiBold" Foreground="#E5484D" />
                                                                                        </Border>
                                                                                        <TextBlock Text="{Binding VersionTypeLabel}" FontSize="10" VerticalAlignment="Center"
                                                                                                   Foreground="{Binding VersionType, Converter={StaticResource VersionTypeBrushConverter}}"
                                                                                                   Visibility="{Binding IsAlpha, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}" />
                                                                                    </StackPanel>
                                                                                    <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                                                                        <TextBlock Text="{Binding FormattedDate}" FontSize="10" Foreground="#777777" />
                                                                                        <TextBlock Text="{Binding FormattedSize}" FontSize="10" Foreground="#777777" />
                                                                                        <TextBlock Text="{Binding FormattedDownloads}" FontSize="10" Foreground="#777777" />
                                                                                    </StackPanel>
                                                                                </StackPanel>

                                                                                <Button Grid.Column="1" Content="下载" Height="30" Padding="16,0" VerticalAlignment="Center"
                                                                                        Background="{ThemeResource AccentBrush}" Foreground="{ThemeResource AccentOnBrush}" BorderThickness="0"
                                                                                        FontSize="12" FontWeight="SemiBold" CornerRadius="4"
                                                                                        Tag="{Binding}" Click="DownloadVersionButton_Click" />
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Expander>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="EmptyVersionText" Text="暂无可用的下载版本" FontSize="12"
                               Foreground="{ThemeResource TextSecondaryBrush}" Visibility="Collapsed" />

                    <!-- 下载操作提示 -->
                    <Border x:Name="QueueTipBorder" Background="#1B2A1B" CornerRadius="6" Padding="12,8" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8FD;" FontSize="13" Foreground="{ThemeResource AccentBrush}" />
                            <TextBlock x:Name="QueueTip" FontSize="12" Foreground="{ThemeResource AccentBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ==================== 加载中 ==================== -->
        <StackPanel Grid.Row="1" x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <ProgressRing IsActive="True" Width="34" Height="34" Foreground="{ThemeResource AccentBrush}" />
            <TextBlock x:Name="LoadingStatusText" Text="正在加载详情…" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12" />
        </StackPanel>
    </Grid>
</UserControl>
