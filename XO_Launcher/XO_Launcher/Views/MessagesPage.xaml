<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="XO_Launcher.Views.MessagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:XO_Launcher.Models"
    xmlns:local="using:XO_Launcher.Views"
    mc:Ignorable="d">

    <UserControl.Resources>
        <models:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Background="{ThemeResource AppBackgroundBrush}" Padding="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Spacing="4">
                <TextBlock Text="消息" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" />
                <TextBlock Text="错误和下载的进度将在此处显示" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="导出错误日志" Height="32" Padding="16,0"
                        Background="{ThemeResource NeutralButtonBrush}" Foreground="{ThemeResource NeutralButtonForegroundBrush}" BorderThickness="0" CornerRadius="4" FontSize="12"
                        Click="ExportLogButton_Click" />
                <Button Content="导出崩溃日志" Height="32" Padding="16,0"
                        Background="{ThemeResource NeutralButtonBrush}" Foreground="{ThemeResource NeutralButtonForegroundBrush}" BorderThickness="0" CornerRadius="4" FontSize="12"
                        Click="ExportCrashButton_Click" />
                <Button x:Name="CancelAllButton" Content="全部终止" Height="32" Padding="16,0"
                        Background="#3A1F1F" Foreground="#E88B8B" BorderThickness="0" CornerRadius="4" FontSize="12"
                        Click="CancelAllButton_Click" Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="CrashCard" Visibility="Collapsed" Margin="0,0,0,16"
                    Background="{ThemeResource CardBackgroundBrush}" CornerRadius="10"
                    BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="故障分析" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextPrimaryBrush}" />
                    </StackPanel>
                    <local:CrashAnalysisPanel x:Name="SessionCrashPanel" Grid.Row="2" Height="260" />
                </Grid>
            </Border>

            <Grid Grid.Row="1">
            <!-- 空状态 -->
            <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <FontIcon Glyph="&#xE8F4;" FontSize="30" Foreground="#4A4A4A" HorizontalAlignment="Center" />
                    <TextBlock Text="暂无下载任务" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>

            <!-- 下载任务列表 -->
            <ListView x:Name="TasksList" SelectionMode="None" IsItemClickEnabled="False" Margin="0,0,0,8">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="10" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1"
                                Padding="16,12" Margin="0,0,0,10">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 状态图标 -->
                                <Border Width="38" Height="38" CornerRadius="8" Background="#1B2A1B" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE896;" FontSize="15" Foreground="{ThemeResource AccentBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="5">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                                            <TextBlock Text="{Binding Status}" FontSize="11"
                                                       Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding ProgressText}" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4"
                                                 IsIndeterminate="{Binding IsIndeterminate}"
                                                 Foreground="{ThemeResource AccentBrush}" Background="{ThemeResource NeutralButtonBrush}" />

                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding FileName}" FontSize="10" Foreground="#777777" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                                            <TextBlock Text="{Binding TransferText}" FontSize="10" Foreground="#777777" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#555555" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="240" />
                                    </Grid>
                                </StackPanel>

                                <Button Grid.Column="2" Content="终止" Height="28" Padding="12,0" VerticalAlignment="Center"
                                        Background="#3A1F1F" Foreground="#E88B8B" BorderThickness="0" CornerRadius="4" FontSize="11"
                                        Tag="{Binding}" Click="CancelTask_Click"
                                        Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
