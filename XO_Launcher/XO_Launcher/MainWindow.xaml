<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="XO_Launcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="XO Launcher">

    <Grid x:Name="RootGrid" Background="{ThemeResource AppBackgroundBrush}">

        <Grid.Resources>
            <Style x:Key="NavPageButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Height" Value="52" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="TitleBarIconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="32" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <DataTemplate x:Key="InstalledVersionItemTemplate">
                <Grid Padding="4,10" ColumnSpacing="14" MinWidth="440">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="6" Background="#5B8731">
                        <FontIcon Glyph="&#xE7FC;" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding LoaderLabel}" FontSize="11" Foreground="{ThemeResource AccentBrush}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <!-- ==================== 顶部导航栏 ==================== -->
        <Grid x:Name="TitleBar" Background="{ThemeResource BarBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="10" Margin="18,0,28,0" VerticalAlignment="Center">
                <Image x:Name="AppIconImage" Width="30" Height="30" Stretch="Uniform" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Grid Width="84">
                    <Button x:Name="HomeNavButton" Content="首页" Style="{StaticResource NavPageButtonStyle}"
                            Foreground="{ThemeResource TextPrimaryBrush}" FontWeight="SemiBold" Click="HomeNavButton_Click" />
                    <Rectangle x:Name="HomeIndicator" Height="3" Fill="{ThemeResource AccentBrush}" VerticalAlignment="Bottom" />
                </Grid>
                <Grid Width="84">
                    <Button x:Name="DownloadNavButton" Content="下载" Style="{StaticResource NavPageButtonStyle}" Click="DownloadNavButton_Click" />
                    <Rectangle x:Name="DownloadIndicator" Height="3" Fill="{ThemeResource AccentBrush}" VerticalAlignment="Bottom" Visibility="Collapsed" />
                </Grid>
                <Grid Width="84">
                    <Button x:Name="SettingsNavButton" Content="设置" Style="{StaticResource NavPageButtonStyle}" Click="SettingsNavButton_Click" />
                    <Rectangle x:Name="SettingsIndicator" Height="3" Fill="{ThemeResource AccentBrush}" VerticalAlignment="Bottom" Visibility="Collapsed" />
                </Grid>
                <Grid Width="84">
                    <Button x:Name="MessagesNavButton" Content="消息" Style="{StaticResource NavPageButtonStyle}" Click="MessagesNavButton_Click" />
                    <Rectangle x:Name="MessagesIndicator" Height="3" Fill="{ThemeResource AccentBrush}" VerticalAlignment="Bottom" Visibility="Collapsed" />
                    <Border x:Name="MessagesBadge" Width="8" Height="8" CornerRadius="4" Background="#E5484D" BorderBrush="#1B1B1B" BorderThickness="1"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,16,0" Visibility="Collapsed" />
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,146,0">
                <Button x:Name="AccountButton" Style="{StaticResource TitleBarIconButtonStyle}" Width="Auto" Height="36" Padding="12,0"
                        ToolTipService.ToolTip="管理账户" Click="AccountButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="24" Height="24" CornerRadius="2" Background="#2E2E2E" BorderBrush="{ThemeResource AccentDarkBrush}" BorderThickness="2">
                            <FontIcon Glyph="&#xE77B;" FontSize="12" Foreground="{ThemeResource AccentBrush}" />
                        </Border>
                        <TextBlock x:Name="AccountNameText" Text="Player" FontSize="13" Foreground="{ThemeResource ChromeTextBrush}" VerticalAlignment="Center" />
                        <FontIcon Glyph="&#xE70D;" FontSize="10" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ==================== 页面内容 ==================== -->
        <Grid Grid.Row="1">
            <Grid x:Name="HomeView" Background="{ThemeResource AppBackgroundBrush}">
                <Grid VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="18" HorizontalAlignment="Center">
                        <Border Width="56" Height="56" CornerRadius="6" Background="{ThemeResource AccentDarkBrush}">
                            <FontIcon Glyph="&#xE823;" FontSize="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="VersionText" Text="--" FontSize="30" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" />
                            <TextBlock x:Name="VersionDescText" Text="未选择版本" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>
                        <Button x:Name="SwitchVersionButton" Height="34" Padding="16,0" VerticalAlignment="Center" Background="{ThemeResource NeutralButtonBrush}"
                                BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1" CornerRadius="4" Foreground="{ThemeResource ChromeTextBrush}" FontSize="13"
                                Click="SwitchVersionButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="切换版本" VerticalAlignment="Center" />
                                <FontIcon Glyph="&#xE70D;" FontSize="10" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="InstanceSettingsButton" Grid.Column="0" Height="42" Padding="16,0"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"
                                Background="{ThemeResource NeutralButtonBrush}" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1" CornerRadius="4"
                                Foreground="{ThemeResource ChromeTextBrush}" FontSize="13" Click="InstanceSettingsButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE713;" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="版本设置" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="PlayButton" Grid.Column="1" Height="64" Width="300" Background="{ThemeResource AccentBrush}"
                                BorderThickness="0" CornerRadius="4" Foreground="{ThemeResource AccentOnBrush}" FontSize="22" FontWeight="Bold"
                                Click="PlayButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE768;" FontSize="22" Foreground="{ThemeResource AccentOnBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="PlayButtonText" Text="启动游戏" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock x:Name="LaunchStatusText" Grid.Row="4" Text="" FontSize="12"
                               Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                </Grid>
            </Grid>

            <Grid x:Name="DownloadHost" Visibility="Collapsed" />
            <Grid x:Name="SettingsHost" Visibility="Collapsed" />
            <Grid x:Name="MessagesHost" Visibility="Collapsed" />
        </Grid>

        <!-- ==================== 底部状态栏（只读展示，选项在设置页修改） ==================== -->
        <Grid Grid.Row="2" Background="{ThemeResource BarBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="28,0,0,0">
                <Border Width="28" Height="28" CornerRadius="2" Background="{ThemeResource AccentDarkBrush}">
                    <TextBlock Text="J" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="JAVA 版本" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="JavaVersionText" Text="未配置" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ChromeTextBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <Rectangle Grid.Column="1" Width="1" Height="32" Fill="{ThemeResource DividerBrush}" VerticalAlignment="Center" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="28" Height="28" CornerRadius="2" Background="#3B4A6B">
                    <FontIcon Glyph="&#xE8B7;" FontSize="13" Foreground="#C7D2E8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="游戏目录" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="GameDirectoryText" Text="未配置" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ChromeTextBrush}"
                           TextTrimming="CharacterEllipsis" MaxWidth="340" VerticalAlignment="Center" />
            </StackPanel>

            <Rectangle Grid.Column="3" Width="1" Height="32" Fill="{ThemeResource DividerBrush}" VerticalAlignment="Center" />

            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,28,0">
                <Border Width="28" Height="28" CornerRadius="2" Background="#7A4B3B">
                    <FontIcon Glyph="&#xE950;" FontSize="13" Foreground="#F0D9C7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="内存分配" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="BottomMemoryText" Text="4096 MB" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ChromeTextBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
